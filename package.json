{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch backend/server.js\" \"vite --host 127.0.0.1\"",
    "start": "node backend/server.js",
    "build": "vite build",
    "lint": "eslint backend frontend tests e2e *.js *.cjs",
